+def _extract_ee_pose_gripper(data, section):
+    """Return official RoboTwin action layout: [pose7, gripper] x 2."""
+    parts = []
+    for side in ("left", "right"):
+        pose = _ensure_2d_float32(
+            _get_nested(data, section, f"{side}_ee_poses"),
+            f"{section}.{side}_ee_poses",
+        )
+        gripper = _ensure_2d_float32(
+            _get_nested(data, section, f"{side}_ee_joint_states"),
+            f"{section}.{side}_ee_joint_states",
+        )
+        if pose.shape[0] != gripper.shape[0] or pose.shape[1] != 7 or gripper.shape[1] != 1:
+            raise ValueError(
+                f"invalid {section} {side} EE shapes: pose={pose.shape}, gripper={gripper.shape}"
+            )
+        parts.extend((pose, gripper))
+    return np.concatenate(parts, axis=1)
+
+
+def _ee_motor_names():
